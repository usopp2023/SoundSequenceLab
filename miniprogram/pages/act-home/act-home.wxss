.brand-from { text-align: center; font-size: 24rpx; color: var(--ink-3); padding: 24rpx 0 28rpx; letter-spacing: .02em; }
.brand-from .b { color: var(--ink-2); font-weight: 500; }

.intro-hero { padding-top: 16rpx; }
.intro-kicker { font-size: 24rpx; color: var(--ink-3); letter-spacing: .26em; text-align: center; }
.intro-title { font-size: 60rpx; text-align: center; margin: 24rpx 0 44rpx; color: var(--ink); letter-spacing: .06em; }
.intro-cover { width: 100%; aspect-ratio: 4 / 3; font-size: 24rpx; letter-spacing: .1em; }

.intro-body { padding: 52rpx 4rpx 0; }
.intro-body .p { font-family: var(--serif); font-size: 32rpx; line-height: 2; color: var(--ink); margin-bottom: 44rpx; }
.intro-h4 { font-size: 26rpx; color: var(--ink-3); letter-spacing: .18em; margin-bottom: 32rpx; }
.step { display: flex; gap: 28rpx; align-items: flex-start; margin-bottom: 32rpx; }
.step .sn {
  flex: none; width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 1rpx solid var(--ink); color: var(--ink);
  font-family: var(--serif); font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.step .st { font-size: 28rpx; line-height: 1.7; color: var(--ink-2); padding-top: 4rpx; }

.intro-foot { padding-top: 32rpx; padding-bottom: 40rpx; }
.privacy-note { text-align: center; font-size: 24rpx; margin-bottom: 24rpx; letter-spacing: .02em; }
.codetip { text-align: center; font-size: 24rpx; color: var(--ink-3); margin-top: 32rpx; letter-spacing: .04em; }
