<view class="tabpage-pad">
  <!-- 活动内身份 -->
  <view class="me-head">
    <view class="me-id" hover-class="row-press" bindtap="editProfile">
      <view class="av"><image wx:if="{{avatarUrl}}" class="av-img" src="{{avatarUrl}}" mode="aspectFill" /></view>
      <view>
        <view class="nm">{{nickname}}</view>
        <view wx:if="{{!profileSet}}" class="me-sub faint">点这里设置头像昵称 ›</view>
      </view>
    </view>
  </view>

  <!-- 我的情绪档案 -->
  <view class="me-sec">
    <view class="sec-h">我的情绪档案</view>
    <scroll-view scroll-x class="archive" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{archive}}"
        wx:key="resultId"
        class="arch-card"
        hover-class="row-press"
        data-id="{{item.resultId}}"
        bindtap="openArchive"
      >
        <view class="ai">〰️</view>
        <view class="an">{{item.name}}</view>
        <view class="ad">{{item.when}}</view>
      </view>
      <view class="arch-card" hover-class="row-press" bindtap="startQuiz">
        <view class="ai">＋</view>
        <view class="an faint">再测一次</view>
        <view class="ad"> </view>
      </view>
    </scroll-view>
  </view>

  <!-- 我收藏的 -->
  <view class="me-sec">
    <view class="sec-h">我收藏的</view>
    <scroll-view wx:if="{{collected.length}}" scroll-x class="archive" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{collected}}"
        wx:key="plazaId"
        class="arch-card"
        hover-class="row-press"
        data-id="{{item.plazaId}}"
        bindtap="openCollected"
      >
        <view class="cx" catchtap="uncollect" data-id="{{item.plazaId}}">✕</view>
        <view class="ai">〰️</view>
        <view class="an">{{item.name}}</view>
        <view class="ad">已收藏</view>
      </view>
    </scroll-view>
    <view wx:else class="arch-empty faint">在广场里点 ♥ 喜欢，就会收藏到这里。</view>
  </view>

  <!-- 我的权益（两档：基础档 / 完整档）-->
  <view class="me-sec">
    <view class="sec-h">我的权益</view>
    <!-- 基础档（完成线上即得）：未解锁完整时显示 -->
    <view wx:if="{{!offlineUnlocked}}" class="perk {{perkOpen[0] ? 'open' : ''}}" data-i="0" bindtap="togglePerk">
      <view class="pi"></view>
      <view class="perk-main">
        <view class="pt1">基础优惠</view>
        <view class="pt2">完成线上体验即可获得</view>
        <view class="perk-detail">
          <view class="pd-row"><text>阿那亚冰箱贴 8 折</text><text class="pd-code">码 8842</text></view>
          <view class="pd-row"><text>喜茶 9 折券</text><text class="pd-code">码 7613</text></view>
          <view class="pd-tip faint">向商家出示此页即可使用（核销码占位）</view>
        </view>
      </view>
      <view class="lock">已解锁</view>
    </view>
    <!-- 完整档（兑换码解锁）：解锁后显示，覆盖基础 -->
    <view wx:if="{{offlineUnlocked}}" class="perk {{perkOpen[1] ? 'open' : ''}}" data-i="1" bindtap="togglePerk">
      <view class="pi"></view>
      <view class="perk-main">
        <view class="pt1">完整权益</view>
        <view class="pt2">已通过兑换码解锁</view>
        <view class="perk-detail">
          <view class="pd-row"><text>阿那亚冰箱贴 6 折</text><text class="pd-code">码 5530</text></view>
          <view class="pd-row"><text>喜茶 8 折券</text><text class="pd-code">码 5531</text></view>
          <view class="pd-row"><text>瑞幸 6 折券</text><text class="pd-code">码 5532</text></view>
          <view class="pd-row"><text>专属阿那亚皮肤 + 勋章</text><text class="pd-code">见下方</text></view>
          <view class="pd-tip faint">向商家出示此页即可使用（核销码占位）</view>
        </view>
      </view>
      <view class="lock">已解锁</view>
    </view>
  </view>

  <!-- 我的奖励（专属皮肤 + 勋章，解锁后点亮）-->
  <view class="me-sec">
    <view class="sec-h">我的奖励</view>
    <view class="rewards {{offlineUnlocked ? '' : 'locked'}}">
      <view class="reward">
        <view class="rw-thumb">
          <view class="rw-card"><text>声序</text><text>限定</text></view>
          <view wx:if="{{!offlineUnlocked}}" class="rw-lock">🔒</view>
        </view>
        <view class="rw-name">专属分享卡片皮肤</view>
        <view class="rw-sub faint">分享到群聊时的限定卡面</view>
      </view>
      <view class="reward">
        <view class="rw-thumb">
          <view class="rw-medal">徽</view>
          <view wx:if="{{!offlineUnlocked}}" class="rw-lock">🔒</view>
        </view>
        <view class="rw-name">阿那亚限定勋章</view>
        <view class="rw-sub faint">完整体验过的专属标记</view>
      </view>
    </view>
    <view wx:if="{{!offlineUnlocked}}" class="reward-tip faint">解锁完整权益后可得 · 输入兑换码领取</view>
  </view>

  <view class="me-codeentry" bindtap="openCode">输入兑换码 · 领取完整权益</view>
</view>
