.me-head { padding: 48rpx 52rpx 32rpx; }
.me-id { display: flex; align-items: center; gap: 28rpx; }
.me-id .av { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--fill); border: 1rpx solid var(--line); flex: none; }
.me-id .nm { font-family: var(--serif); font-size: 38rpx; font-weight: 600; }
.badge {
  display: inline-block; margin-top: 12rpx; font-size: 22rpx; color: var(--ink-2);
  border: 1rpx solid var(--line); border-radius: 999rpx; padding: 6rpx 20rpx; letter-spacing: .06em;
}
.me-sub { font-size: 24rpx; margin-top: 20rpx; }

.me-sec { padding: 16rpx 52rpx; }
.sec-h { font-size: 24rpx; color: var(--ink-3); letter-spacing: .16em; margin: 36rpx 0 24rpx; }

.archive { white-space: nowrap; }
.arch-card { display: inline-block; width: 240rpx; margin-right: 24rpx; vertical-align: top; }
.row-press { opacity: .7; }
.ai {
  width: 240rpx; height: 240rpx; border-radius: 28rpx;
  background: var(--fill); border: 3rpx dashed #cbc8c2;
  display: flex; align-items: center; justify-content: center; color: #a8a5a0; font-size: 48rpx;
}
.an { font-family: var(--serif); font-size: 26rpx; margin-top: 16rpx; }
.ad { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.arch-note { font-size: 22rpx; margin-top: 20rpx; }
.arch-empty { font-size: 24rpx; line-height: 1.7; padding: 12rpx 4rpx; }

.perk {
  display: flex; align-items: flex-start; gap: 28rpx; padding: 32rpx;
  border: 1rpx solid var(--line); border-radius: 28rpx; margin-bottom: 24rpx;
}
.perk .pi { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: var(--fill); border: 1rpx solid var(--line); flex: none; }
.perk-main { flex: 1; min-width: 0; }
.perk .pt1 { font-size: 28rpx; color: var(--ink); }
.perk .pt2 { font-size: 22rpx; color: var(--ink-3); margin-top: 6rpx; }
.perk .lock { margin-left: 16rpx; font-size: 22rpx; color: var(--ink-3); flex: none; padding-top: 4rpx; }
.perk-detail { display: none; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line-2); }
.perk.open .perk-detail { display: block; }
.pd-row { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: var(--ink); }
.pd-code { font-family: var(--serif); font-size: 26rpx; color: var(--ink-2); border: 1rpx solid var(--line); border-radius: 12rpx; padding: 4rpx 16rpx; letter-spacing: .1em; }
.pd-tip { font-size: 22rpx; margin-top: 16rpx; line-height: 1.6; }

.me-codeentry { margin: 12rpx 52rpx 48rpx; text-align: center; font-size: 26rpx; color: var(--ink-2); text-decoration: underline; }
