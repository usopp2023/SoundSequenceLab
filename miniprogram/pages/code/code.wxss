.code-page { min-height: 100vh; background: #fff; display: flex; flex-direction: column; }
.code-wrap { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 0 52rpx; }
.code-title { font-family: var(--serif); font-size: 44rpx; font-weight: 600; text-align: center; }
.code-sub { text-align: center; font-size: 26rpx; color: var(--ink-2); margin-top: 24rpx; line-height: 1.8; }
.br { display: block; height: 0; }
.code-input {
  margin-top: 68rpx; width: 100%; text-align: center;
  font-family: var(--serif); font-size: 48rpx; letter-spacing: .3em;
  padding: 32rpx; border: 1rpx solid var(--line); border-radius: 28rpx;
}
.gap { height: 60rpx; }
.scan-row { margin-top: 24rpx; }
.code-demo { text-align: center; font-size: 22rpx; margin-top: 36rpx; letter-spacing: .04em; }
