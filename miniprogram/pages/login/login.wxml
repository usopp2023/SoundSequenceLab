<view class="login">
  <view class="login-hero">
    <view class="ambient"></view>
    <view class="login-title display">设置你的头像和昵称</view>
    <view class="login-sub">用于在活动里显示你，不会公开你的回答</view>
  </view>

  <view class="login-form">
    <!-- 头像（微信「头像昵称填写能力」）-->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-ph">＋<view class="avatar-ph-tip">选择头像</view></view>
    </button>
    <view class="nick-row">
      <input
        class="nick-input"
        type="nickname"
        placeholder="点这里填写昵称"
        value="{{nickname}}"
        bindinput="onNickInput"
        bindblur="onNickInput"
      />
    </view>
  </view>

  <view class="login-foot">
    <button class="btn {{canSave ? '' : 'disabled'}}" disabled="{{!canSave}}" hover-class="active-press" bindtap="save">保存</button>
    <view class="login-priv faint">仅用于在活动里显示你的昵称头像，不会公开你的回答。</view>
  </view>
</view>
