.login {
  min-height: 100vh; background: #fff;
  display: flex; flex-direction: column; align-items: center;
  padding: 0 68rpx;
}
.login-hero {
  display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
  padding: 60rpx 0 16rpx;
}
.login-hero .ambient { width: 150rpx; height: 150rpx; margin-bottom: 36rpx; }
.login-title { font-size: 44rpx; letter-spacing: .04em; color: var(--ink); }
.login-sub { font-size: 26rpx; line-height: 1.8; color: var(--ink-2); margin-top: 20rpx; }

.login-form { display: flex; flex-direction: column; align-items: center; gap: 32rpx; padding: 24rpx 0 48rpx; }
.avatar-btn {
  width: 160rpx; height: 160rpx; padding: 0; border-radius: 50%;
  background: var(--fill); border: 1rpx solid var(--line); overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 160rpx; height: 160rpx; }
.avatar-ph { color: #a8a5a0; font-size: 44rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-ph-tip { font-size: 20rpx; margin-top: 6rpx; letter-spacing: .08em; }
.nick-row { width: 100%; }
.nick-input {
  width: 100%; text-align: center;
  font-family: var(--serif); font-size: 34rpx; color: var(--ink);
  padding: 24rpx; border-bottom: 1rpx solid var(--line);
}

.login-foot { width: 100%; padding-bottom: 80rpx; }
.login-priv { text-align: center; font-size: 22rpx; margin-top: 24rpx; letter-spacing: .02em; line-height: 1.7; }
