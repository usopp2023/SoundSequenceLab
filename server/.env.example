# 声序实验室 · 情绪音乐 后端环境变量示例
# 复制为 .env 并填入真实值。本轮全部为占位，无需真实 key。

# 微信小程序 code2session（真实登录时使用）
WECHAT_APPID=
WECHAT_SECRET=

# 多模态分析大模型（如 Gemini / GPT-4o-audio / 豆包等）
ANALYSIS_API_KEY=
ANALYSIS_API_BASE=

# Suno 音乐生成渠道（注意 Suno 无官方公开 API，渠道需确认）
SUNO_API_KEY=
SUNO_API_BASE=

# 数据库（默认 SQLite，无需修改）
DATABASE_URL=sqlite:///./shengxu.db

# 静态资源访问前缀（如部署到 CDN 可改）
STATIC_BASE=/static
